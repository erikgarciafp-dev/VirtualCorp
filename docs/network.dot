    r0 -> pl0   [color="#4a9a4a"];
    r0 -> priv  [color="#8a5fb0"];
    r0 -> dmz   [color="#c95b5b"];
    r1 -> pl1   [color="#4a9a4a"];
    r2 -> pl2   [color="#4a9a4a"];
