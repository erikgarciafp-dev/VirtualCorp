    r2 -> r3 [label=<<B>rt2_3</B><BR/>10.7.0.232/30<BR/>.233 — .234>, color="#c98a1a"];

    node [shape=box, style="filled", fillcolor="#e4f4e4", color="#4a9a4a", width=2.3];
    pl0   [label=<<B>pl0</B> · 10.7.0.0/25<BR/>gw .1<BR/>expo1-4 (.33-.36)<BR/>printer0 (.65)<BR/>conserge1, conserge2>];
    priv  [label=<<B>privada</B> · 10.7.0.128/26<BR/>gw .129<BR/>pve01 (.133)<BR/>dbsrv (.134) · infosrv (.135)>, fillcolor="#efe4f7", color="#8a5fb0"];
    dmz   [label=<<B>dmz</B> · 10.7.0.192/27<BR/>gw .193<BR/>websrv (.197)>, fillcolor="#fbe4e4", color="#c95b5b"];
    pl1   [label=<<B>pl1</B> · 10.7.1.0/24<BR/>gw .1<BR/>printer1 (.65)<BR/>pc1>];
    pl2   [label=<<B>pl2</B> · 10.7.2.0/24<BR/>gw .1<BR/>printer2 (.65)<BR/>pc2>];
    pl3   [label=<<B>pl3</B> · 10.7.3.0/25<BR/>gw .1<BR/>printer3 (.65)<BR/>pc3>];
